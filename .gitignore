# Build output
/gcp-local
/bin/
*.exe

# Coverage / profiling
coverage.out
*.prof

# OS
.DS_Store
Thumbs.db

# Python tests
tests/python/.venv/
tests/python/__pycache__/
tests/python/.pytest_cache/

# Node tests
tests/typescript/node_modules/
tests/typescript/.vite/

# Tool / IDE state — block every dotfolder by default at every level.
# Explicit allow-list below for things we do want in the repo.
.*/
!.github/
!.agents/
!.claude/
.claude/*
!.claude/skills
!.sg/

# Also ignore stray dotfiles produced by tooling.
ruvector.db
.mcp.json

# Holdout programs written by the accept agent; never commit them.
tests/go/zz_holdout_*
tests/python/test_zz_holdout_*
tests/typescript/zz_holdout_*

# Terraform test harness
tests/terraform/.terraform/
tests/terraform/terraform.tfstate*
